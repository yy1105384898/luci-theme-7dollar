				],
				"luci": [
					"setInitAction"
				],
				"file": [
					"exec"
				]
			},
			"uci": [
				"7dollar",
				"luci"
			],
			"file": {
				"/opt/open-box/openwrt/bin/open-box start --detach": [
					"exec"
				],
				"/opt/open-box/update.sh --detach --direct --expect *": [
					"exec"
				],
				"/opt/open-box/update.sh --detach --mirror * --expect *": [
					"exec"
				]
			}
		}
	}
